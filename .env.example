# ============================================================
#  ENVIRONMENT VARIABLES  —  copy this file to `.env.local`
#  Everything here is OPTIONAL. The site runs fully without it.
# ============================================================

# --- Contact form email delivery (optional) ---------------------------------
# The contact form works without this: if no key is set, the API returns a
# graceful "fallback" response and the UI offers a mailto: link instead.
# To enable real email delivery, create a free account at https://resend.com,
# verify a sending domain, and paste the key below.
RESEND_API_KEY=
# The verified "from" address Resend will send on behalf of (e.g. portfolio@yourdomain.com)
CONTACT_FROM_EMAIL=
# Where contact-form messages are delivered (defaults to Aakshat's email if unset)
CONTACT_TO_EMAIL=aakshatagarwal2004@gmail.com

# --- Analytics (optional) ----------------------------------------------------
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# --- Local Site URL (optional, used for absolute SEO/OG URLs in development) -
# Production SEO URLs use the canonical domain (https://www.aakshat.in) in lib/site.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
